# Environment variables and secrets — never commit
.env
.env.*
!.env.example

# Certificates (never push to source control)
cert/
*.pfx
*.pem
*.crt
*.key
*.p12

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
*.pid
*.seed
*.pid.lock

# Coverage directories
lib-cov
coverage
.nyc_output

# Dependency directories
node_modules/
jspm_packages

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Build output directories
dist/
build/
*.tsbuildinfo

# OS files
.DS_Store

# IntelliJ IDEA project files; if you want to commit IntelliJ settings, this recipe may be helpful:
# https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
.idea/
*.iml

# Python
__pycache__/

*.zip

# Authentication and test artifacts.
# playwright-ms-auth resolves its state directory from the CWD's nearest
# package.json, so running auth from the repo root writes session cookies and
# MSAL refresh tokens to a root-level .playwright-ms-auth/ — match it at any depth.
.playwright-ms-auth/
screenshots/
cert/
.envcopy
test-results*/
playwright-report/
.playwright-test-results/

# Debug screenshot written by scripts/authenticate.ts on MDA auth failure —
# it captures an authenticated session.
model-driven-error.png

# Local dev / scratch files
bugs.json
